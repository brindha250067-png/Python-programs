# Program to sort elements in ascending and descending order

n = int(input("Enter number of elements: "))

arr = []

for i in range(n):
    num = int(input("Enter element: "))
    arr.append(num)

# Ascending order
arr.sort()
print("Ascending Order:", arr)

# Descending order
arr.sort(reverse=True)
print("Descending Order:", arr)
